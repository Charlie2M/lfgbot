DISCORD_TOKEN=your-bot-token-here
# Optional: a test server ID, so slash commands sync there instantly during development
DEV_GUILD_ID=
# Where Game Stats API is running (used by /profile and Valorant matching in /lfg)
GAME_STATS_API_URL=http://127.0.0.1:8000
# Must match BOT_API_KEY on the API server, or /profile can't save (generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))")
GAME_STATS_API_KEY=
